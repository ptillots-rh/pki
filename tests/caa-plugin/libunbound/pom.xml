<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.dogtagpki.tests</groupId>
        <artifactId>caa-tests</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>caa-libunbound</artifactId>
    <!-- Both the adapter and DNS dependency are absent from default builds. -->
    <dependencies>
        <dependency>
            <groupId>org.dogtagpki.tests</groupId>
            <artifactId>caa-acme</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Standard test-JAR dependency, never part of adapter runtime delivery. -->
        <dependency>
            <groupId>org.dogtagpki.tests</groupId>
            <artifactId>caa-acme</artifactId>
            <version>${project.version}</version>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dnsjava</groupId>
            <artifactId>dnsjava</artifactId>
            <version>3.6.5</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <sourceDirectory>${project.basedir}/../../../base/acme/caa-plugins/libunbound/src/main/java</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Xcheck:jni -Djava.library.path=${project.basedir}/target/native</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
